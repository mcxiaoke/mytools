<Window x:Class="ScreenLock.Views.ConfigEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="配置编辑器 - ScreenLock" Height="620" Width="560"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Background="#FFF7F7F7">
    <Window.Resources>
        <!-- 窄滚动条：垂直 6px，圆角灰色滑块 -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#FFC8C8C8" CornerRadius="3" Margin="1,0"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 路径提示 -->
                <Border Background="#FFE8F0FE" CornerRadius="6" Padding="10,8" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="配置文件位置" FontWeight="Bold" FontSize="12" Foreground="#FF1A73E8"/>
                        <TextBlock x:Name="PathText" Text="--" FontSize="11" Foreground="#FF333333" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        <TextBlock x:Name="ModeText" Text="--" FontSize="11" Foreground="#FF666666" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 基础设置 -->
                <Border Background="White" CornerRadius="6" BorderBrush="#FFE0E0E0" BorderThickness="1" Padding="12" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="基础设置" FontWeight="Bold" Foreground="#FF444444" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Text="空闲锁屏" VerticalAlignment="Center"/>
                            <ComboBox x:Name="IdleBox" Grid.Column="1" Height="26" Margin="0,4" IsEditable="True" ToolTip="0=禁用，1-1440 分钟">
                                <ComboBoxItem Content="0 - 禁用"/>
                                <ComboBoxItem Content="1"/>
                                <ComboBoxItem Content="3"/>
                                <ComboBoxItem Content="5"/>
                                <ComboBoxItem Content="10"/>
                                <ComboBoxItem Content="15"/>
                                <ComboBoxItem Content="30"/>
                                <ComboBoxItem Content="60"/>
                            </ComboBox>
                            <TextBlock Grid.Column="2" Text="分钟" VerticalAlignment="Center" Margin="6,0,0,0"/>

                            <TextBlock Grid.Row="1" Text="显示时钟" VerticalAlignment="Center" Margin="0,8,0,0"/>
                            <CheckBox x:Name="ShowClockBox" Grid.Row="1" Grid.Column="1" Content="锁屏界面显示时钟" VerticalAlignment="Center" Margin="0,8,0,0"/>

                            <TextBlock Grid.Row="2" Text="遮罩透明度" VerticalAlignment="Center" Margin="0,8,0,0"/>
                            <Slider x:Name="OpacitySlider" Grid.Row="2" Grid.Column="1" Minimum="0.3" Maximum="1.0" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="0.88" Margin="0,8,0,0" ValueChanged="OpacitySlider_ValueChanged"/>
                            <TextBlock x:Name="OpacityText" Grid.Row="2" Grid.Column="2" Text="0.88" VerticalAlignment="Center" Margin="6,8,0,0"/>

                            <TextBlock Grid.Row="3" Grid.Column="1" Text="0.3 最透 · 1.0 不透" Foreground="#FF888888" FontSize="11" Margin="0,2,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 系统集成 -->
                <Border Background="White" CornerRadius="6" BorderBrush="#FFE0E0E0" BorderThickness="1" Padding="12" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="系统集成" FontWeight="Bold" Foreground="#FF444444" Margin="0,0,0,10"/>
                        <CheckBox x:Name="AutoStartBox" Content="开机自启（写入注册表 Run）" Margin="0,2,0,0"/>
                        <CheckBox x:Name="TasksEnabledBox" Content="启用任务调度（全局总开关）" Margin="0,8,0,0" IsChecked="True"/>
                        <TextBlock Text="关闭后所有定时/热键/监听任务将暂停" Foreground="#FF888888" FontSize="11" Margin="20,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 排除进程 -->
                <Border Background="White" CornerRadius="6" BorderBrush="#FFE0E0E0" BorderThickness="1" Padding="12" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="排除进程（防游戏挂机误锁）" FontWeight="Bold" Foreground="#FF444444" Margin="0,0,0,6"/>
                        <TextBlock Text="列出的进程运行时暂停空闲计时，支持 game.exe 或完整路径，大小写不敏感" Foreground="#FF888888" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="ExcludeInputBox" Height="26" Padding="4,2" ToolTip="输入进程名如 eldenring.exe 回车添加"/>
                            <Button Content="添加" Grid.Column="1" Height="26" Margin="4,0,0,0" Click="OnExcludeAddClick"/>
                            <Button Content="删除" Grid.Column="2" Height="26" Margin="4,0,0,0" Click="OnExcludeDeleteClick"/>
                        </Grid>
                        <ListBox x:Name="ExcludeList" Height="110" Margin="0,8,0,0" SelectionMode="Single"/>
                        <TextBlock Text="提示：可填 GenshinImpact.exe / eldenring / qbittorrent.exe 等，空列表表示不排除" Foreground="#FF888888" FontSize="11" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 安全 -->
                <Border Background="White" CornerRadius="6" BorderBrush="#FFE0E0E0" BorderThickness="1" Padding="12" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="安全" FontWeight="Bold" Foreground="#FF444444" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
                            <TextBlock Text="PIN 状态" VerticalAlignment="Center"/>
                            <TextBlock x:Name="PinStatusText" Grid.Column="1" Text="--" VerticalAlignment="Center" Foreground="#FF333333"/>
                            <Button x:Name="PinButton" Grid.Column="2" Content="修改 PIN" Height="26" Click="OnPinChangeClick"/>
                        </Grid>
                        <TextBlock Text="PIN 用于解锁屏幕与退出程序，修改后立即生效" Foreground="#FF888888" FontSize="11" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="ValidateText" Foreground="#FFD93025" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="校验" Width="80" Height="32" Margin="4,0" Click="OnValidateClick"/>
            <Button Content="保存并应用" Width="100" Height="32" Margin="4,0" Click="OnSaveApplyClick"/>
            <Button Content="保存" Width="80" Height="32" Margin="4,0" Click="OnSaveClick"/>
            <Button Content="关闭" Width="80" Height="32" Margin="4,0" Click="OnCloseClick"/>
        </StackPanel>
    </Grid>
</Window>
