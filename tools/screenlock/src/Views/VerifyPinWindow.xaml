<Window x:Class="ScreenLock.Views.VerifyPinWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="验证 PIN" Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        WindowStyle="ToolWindow">
    <StackPanel Margin="26,22,26,16">
        <TextBlock x:Name="TitleText" Text="请输入 PIN 验证身份" FontSize="15" FontWeight="SemiBold"/>
        <PasswordBox x:Name="PinBox" Height="36" FontSize="18" MaxLength="16" Padding="6,4" Margin="0,14,0,0"/>
        <TextBlock x:Name="MessageText" FontSize="13" Foreground="#FFD93025" Margin="0,10,0,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="确定" Width="84" Height="30" Margin="0,0,10,0" Click="OnOkClick"/>
            <Button Content="取消" Width="84" Height="30" Click="OnCancelClick"/>
        </StackPanel>
    </StackPanel>
</Window>
