<Window x:Class="ScreenLock.Views.FirstRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置 PIN" Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        WindowStyle="ToolWindow">
    <StackPanel Margin="28,24,28,20">
        <TextBlock Text="欢迎使用 ScreenLock" FontSize="20" FontWeight="Bold"/>
        <TextBlock Text="首次使用请先设置解锁 PIN（至少 4 位），用于解锁屏幕和退出程序。" FontSize="13" Foreground="#FF666666" TextWrapping="Wrap" Margin="0,8,0,18"/>
        <TextBlock Text="输入 PIN" FontSize="13" Margin="0,0,0,4"/>
        <PasswordBox x:Name="PinBox1" Height="34" FontSize="16" MaxLength="16" Padding="6,4"/>
        <TextBlock Text="再次输入确认" FontSize="13" Margin="0,12,0,4"/>
        <PasswordBox x:Name="PinBox2" Height="34" FontSize="16" MaxLength="16" Padding="6,4"/>
        <TextBlock x:Name="MessageText" FontSize="13" Foreground="#FFD93025" Margin="0,10,0,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="确定" Width="90" Height="32" Click="OnOkClick"/>
        </StackPanel>
    </StackPanel>
</Window>
