<Window x:Class="ScreenLock.Views.LockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent"
        Focusable="False"
        Cursor="None">
    <Border x:Name="RootBorder" Background="#FF0B0F14">
        <Grid>
            <StackPanel x:Name="InputPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock Text="屏幕已锁定" FontSize="34" FontWeight="Bold" Foreground="#FFD8DEE9" HorizontalAlignment="Center"/>
                <TextBlock x:Name="ClockText" FontSize="18" Foreground="#FF7C8698" HorizontalAlignment="Center" Margin="0,12,0,36"/>
                <TextBlock Text="输入 PIN 解锁" FontSize="15" Foreground="#FF9AA5B5" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <PasswordBox x:Name="PinBox" Width="260" Height="42" FontSize="22" MaxLength="16"
                             HorizontalContentAlignment="Center" Background="#FF161B22" Foreground="White"
                             BorderBrush="#FF30363D" BorderThickness="1" Padding="6,4"/>
                <Button x:Name="UnlockButton" Content="解 锁" Width="260" Height="38" Margin="0,14,0,0"
                        FontSize="15" Background="#FF1F6FEB" Foreground="White" BorderThickness="0"
                        Cursor="Hand" Click="OnUnlockClick"/>
                <TextBlock x:Name="MessageText" FontSize="13" Foreground="#FFF85149" HorizontalAlignment="Center"
                           Margin="0,14,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
            </StackPanel>
            <StackPanel x:Name="CoverPanel" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="已锁定" FontSize="40" FontWeight="Bold" Foreground="#FF3A4352" HorizontalAlignment="Center"/>
                <TextBlock x:Name="CoverClockText" FontSize="20" Foreground="#FF3A4352" HorizontalAlignment="Center" Margin="0,12,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
