<ui:FluentWindow x:Class="HideFiles.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:HideFiles.App.ViewModels"
                 Title="{Binding Title}"
                 Height="720" Width="980"
                 MinHeight="580" MinWidth="780"
                 WindowStartupLocation="CenterScreen"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True"
                 Icon="pack://application:,,,/HideFilesApp;component/Assets/Icon/AppIcon.png">

    <ui:FluentWindow.DataContext>
        <vm:MainViewModel />
    </ui:FluentWindow.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题栏：带图标与标题 -->
        <ui:TitleBar Grid.Row="0" Title="{Binding Title}">
            <ui:TitleBar.Icon>
                <ui:ImageIcon>
                    <ui:ImageIcon.Source>
                        <BitmapImage UriSource="pack://application:,,,/HideFilesApp;component/Assets/Icon/AppIcon.png" />
                    </ui:ImageIcon.Source>
                </ui:ImageIcon>
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- 主内容多标签页 -->
        <TabControl x:Name="RootTabControl" Grid.Row="1" Margin="16,4,16,12" SelectedIndex="{Binding SelectedTabIndex}">
            <!-- TAB 1: 结构加密 -->
            <TabItem Header="结构加密">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="当前文件: " Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding TotalCount}" FontWeight="Bold" Margin="0,0,16,0" />
                                <TextBlock Text="未加密: " Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding NormalCount}" FontWeight="Bold" Foreground="#10B981" Margin="0,0,16,0" />
                                <TextBlock Text="已加密: " Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding ObfuscatedCount}" FontWeight="Bold" Foreground="#F59E0B" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="选择文件" Command="{Binding SelectFilesCommand}" CommandParameter="struct" Margin="0,0,8,0" AutomationProperties.AutomationId="StructSelectFiles" />
                                <Button Content="选择文件夹" Command="{Binding SelectFolderCommand}" CommandParameter="struct" Margin="0,0,8,0" />
                                <Button Content="清空列表" Command="{Binding ClearFilesCommand}" CommandParameter="struct" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="原地加密文件头部与关键结构，支持大文件快速处理"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <ui:Button Content="加密" Command="{Binding ObfuscateSelectedCommand}"
                                       Appearance="Primary" Margin="0,0,8,0" AutomationProperties.AutomationId="StructObfuscate" />
                            <ui:Button Content="解密" Command="{Binding RestoreSelectedCommand}"
                                       Appearance="Secondary" AutomationProperties.AutomationId="StructRestore" />
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="2" Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8"
                            AllowDrop="True" Drop="FileList_Drop" DragOver="FileList_DragOver">
                        <Grid>
                            <!-- 空状态引导占位 -->
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                        Visibility="{Binding HasFiles, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}">
                                <TextBlock Text="📂" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,10" />
                                <TextBlock Text="拖拽文件或文件夹到此处" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                <TextBlock Text="支持任意格式音视频、图片及文档" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,14" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <ui:Button Content="选择文件" Command="{Binding SelectFilesCommand}" CommandParameter="struct" Margin="0,0,8,0" />
                                    <ui:Button Content="选择文件夹" Command="{Binding SelectFolderCommand}" CommandParameter="struct" />
                                </StackPanel>
                            </StackPanel>

                            <!-- 文件列表 -->
                            <DataGrid x:Name="StructFileGrid" ItemsSource="{Binding Files}" AutoGenerateColumns="False" CanUserAddRows="False"
                                      GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                                      Background="Transparent" BorderThickness="0"
                                      Visibility="{Binding HasFiles, Converter={StaticResource BoolToVisibilityConverter}}">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Width="50">
                                        <DataGridTemplateColumn.Header>
                                            <CheckBox Command="{Binding DataContext.ToggleSelectAllCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                      CommandParameter="struct" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0" Padding="0" />
                                        </DataGridTemplateColumn.Header>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" 
                                                          HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0" Padding="0" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="状态" Width="80">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="4" Padding="6,2"
                                                        Background="{Binding Status, Converter={StaticResource StatusToColorConverter}}"
                                                        HorizontalAlignment="Center">
                                                    <TextBlock Text="{Binding StatusText}" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="文件名" Binding="{Binding FileName}" Width="180" FontWeight="SemiBold" />
                                    <DataGridTextColumn Header="原始文件名" Binding="{Binding OriginalFileName}" Width="160" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <DataGridTextColumn Header="大小" Binding="{Binding DisplaySize}" Width="80" />
                                    <DataGridTextColumn Header="完整路径" Binding="{Binding FilePath}" MinWidth="300" Width="*" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    <DataGridTemplateColumn Header="操作" Width="50">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="✕" ToolTip="移出列表" Padding="0" Width="22" Height="22"
                                                        Command="{Binding DataContext.RemoveFileCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        Background="Transparent" BorderThickness="0"
                                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 2: 整体加密 -->
            <TabItem Header="整体加密">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="当前文件: " Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding SecureTotalCount}" FontWeight="Bold" Margin="0,0,16,0" />
                                <TextBlock Text="未加密: " Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding SecureNormalCount}" FontWeight="Bold" Foreground="#10B981" Margin="0,0,16,0" />
                                <TextBlock Text="已加密: " Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding SecureObfuscatedCount}" FontWeight="Bold" Foreground="#F59E0B" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="选择文件" Command="{Binding SelectFilesCommand}" CommandParameter="secure" Margin="0,0,8,0" AutomationProperties.AutomationId="SecureSelectFiles" />
                                <Button Content="选择文件夹" Command="{Binding SelectFolderCommand}" CommandParameter="secure" Margin="0,0,8,0" />
                                <Button Content="清空列表" Command="{Binding ClearFilesCommand}" CommandParameter="secure" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="分块加密全文件（AES-256-GCM），支持任意格式"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <ui:Button Content="加密" Command="{Binding EncryptSelectedCommand}"
                                       Appearance="Primary" Margin="0,0,8,0" AutomationProperties.AutomationId="SecureEncrypt" />
                            <ui:Button Content="解密" Command="{Binding DecryptSelectedCommand}"
                                       Appearance="Secondary" AutomationProperties.AutomationId="SecureDecrypt" />
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="2" Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8"
                            AllowDrop="True" Drop="FileList_Drop" DragOver="FileList_DragOver">
                        <Grid>
                            <!-- 空状态引导占位 -->
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                        Visibility="{Binding HasSecureFiles, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}">
                                <TextBlock Text="📂" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,10" />
                                <TextBlock Text="拖拽文件或文件夹到此处" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                <TextBlock Text="支持任意格式音视频、图片及文档" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,14" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <ui:Button Content="选择文件" Command="{Binding SelectFilesCommand}" CommandParameter="secure" Margin="0,0,8,0" />
                                    <ui:Button Content="选择文件夹" Command="{Binding SelectFolderCommand}" CommandParameter="secure" />
                                </StackPanel>
                            </StackPanel>

                            <!-- 文件列表 -->
                            <DataGrid x:Name="SecureFileGrid" ItemsSource="{Binding SecureFiles}" AutoGenerateColumns="False" CanUserAddRows="False"
                                      GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                                      Background="Transparent" BorderThickness="0"
                                      Visibility="{Binding HasSecureFiles, Converter={StaticResource BoolToVisibilityConverter}}">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Width="50">
                                        <DataGridTemplateColumn.Header>
                                            <CheckBox Command="{Binding DataContext.ToggleSelectAllCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                      CommandParameter="secure" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0" Padding="0" />
                                        </DataGridTemplateColumn.Header>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" 
                                                          HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0" Padding="0" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="状态" Width="80">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="4" Padding="6,2"
                                                        Background="{Binding Status, Converter={StaticResource StatusToColorConverter}}"
                                                        HorizontalAlignment="Center">
                                                    <TextBlock Text="{Binding StatusText}" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="文件名" Binding="{Binding FileName}" Width="180" FontWeight="SemiBold" />
                                    <DataGridTextColumn Header="原始文件名" Binding="{Binding OriginalFileName}" Width="160" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <DataGridTextColumn Header="大小" Binding="{Binding DisplaySize}" Width="80" />
                                    <DataGridTextColumn Header="完整路径" Binding="{Binding FilePath}" MinWidth="300" Width="*" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    <DataGridTemplateColumn Header="操作" Width="50">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="✕" ToolTip="移出列表" Padding="0" Width="22" Height="22"
                                                        Command="{Binding DataContext.RemoveFileCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        Background="Transparent" BorderThickness="0"
                                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 3: 设置 -->
            <TabItem Header="设置">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                    <StackPanel>
                        <!-- 卡片 1: 密码与恢复码 -->
                        <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="密码设置" FontWeight="Bold" FontSize="14" Margin="0,0,0,6" />
                                <TextBlock Text="设置保护与解密文件的主密码。" 
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,12" TextWrapping="Wrap" />

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <TextBlock Text="当前状态: " VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <Border Background="#1A10B981" CornerRadius="4" Padding="8,3" Margin="4,0,0,0"
                                            Visibility="{Binding HasPinConfigured, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="已设置密码" Foreground="#10B981" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </Border>
                                    <Border Background="#1A6B7280" CornerRadius="4" Padding="8,3" Margin="4,0,0,0"
                                            Visibility="{Binding HasPinConfigured, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}">
                                        <TextBlock Text="未设置密码" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                    </Border>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <!-- 未设置密码时：显示“设置密码”按钮 -->
                                    <ui:Button Content="设置密码" Command="{Binding PromptSetPinCommand}" Appearance="Primary" Margin="0,0,10,0"
                                               Visibility="{Binding HasPinConfigured, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}" />

                                    <!-- 已设置密码时：显示“修改密码”和“清除密码”按钮 -->
                                    <ui:Button Content="修改密码" Command="{Binding PromptChangePinCommand}" Appearance="Secondary" Margin="0,0,10,0"
                                               Visibility="{Binding HasPinConfigured, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <ui:Button Content="清除密码" Command="{Binding PromptClearPinCommand}" Appearance="Danger"
                                               Visibility="{Binding HasPinConfigured, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </StackPanel>

                                <StackPanel Margin="0,4,0,8"
                                            Visibility="{Binding HasRecoveryCode, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Grid Margin="0,0,0,4">
                                        <TextBlock Text="恢复码（请妥善保存，仅显示一次）：" FontSize="12" Foreground="#BA7517" VerticalAlignment="Center" />
                                        <ui:Button Content="复制恢复码" Command="{Binding CopyRecoveryCodeCommand}" HorizontalAlignment="Right" Height="26" Padding="8,2" />
                                    </Grid>
                                    <TextBox Text="{Binding RecoveryCodeDisplay, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                             FontFamily="Consolas" FontSize="13" Background="#14000000" Padding="8" />
                                </StackPanel>

                                <TextBlock Text="提示：忘记密码时可使用恢复码解密文件。请务必妥善保存密码与恢复码。"
                                           FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- 卡片: 运行模式与数据存储 (便携模式支持) -->
                        <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="运行模式与数据存储" FontWeight="Bold" FontSize="14" Margin="0,0,0,6" />
                                <TextBlock Text="支持 Windows 标准漫游模式与纯绿色便携模式。" 
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,12" TextWrapping="Wrap" />

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <TextBlock Text="当前模式: " VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <Border Background="#1A3B82F6" CornerRadius="4" Padding="8,3" Margin="4,0,0,0"
                                            Visibility="{Binding IsPortableMode, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="便携模式 (Portable)" Foreground="#3B82F6" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </Border>
                                    <Border Background="#1A10B981" CornerRadius="4" Padding="8,3" Margin="4,0,0,0"
                                            Visibility="{Binding IsPortableMode, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}">
                                        <TextBlock Text="标准模式 (Roaming)" Foreground="#10B981" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </Border>
                                </StackPanel>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="数据目录: " VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,8,0" />
                                    <TextBox Grid.Column="1" Text="{Binding DataDirectoryDisplay, Mode=OneWay}" IsReadOnly="True"
                                             VerticalContentAlignment="Center" Height="32" Margin="0,0,10,0"
                                             Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <ui:Button Grid.Column="2" Content="打开目录" Command="{Binding OpenDataDirectoryCommand}" Appearance="Secondary" />
                                </Grid>

                                <TextBlock Text="便携说明：在程序同级目录下放置 portable.ini 标志文件或 app_data 文件夹，配置数据将存储在本地 app_data 目录，实现纯绿色免安装便携运行。"
                                           FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- 卡片 2: 结构加密与文件名设置 -->
                        <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="结构加密与文件名" FontWeight="Bold" FontSize="14" Margin="0,0,0,12" />
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="头部加密长度:" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" SelectedValuePath="Tag" SelectedValue="{Binding Config.HeadObfuscateSize}" Width="260" HorizontalAlignment="Left">
                                        <ComboBoxItem Content="4 KB" Tag="4096" />
                                        <ComboBoxItem Content="64 KB（默认）" Tag="65536" IsSelected="True" />
                                        <ComboBoxItem Content="256 KB" Tag="262144" />
                                        <ComboBoxItem Content="1 MB" Tag="1048576" />
                                    </ComboBox>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="文件名:" VerticalAlignment="Center" />
                                    <CheckBox Grid.Column="1" Content="修改文件名（添加 hf_ 前缀）" 
                                              IsChecked="{Binding Config.ObfuscateFileName}" />
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="扫描范围:" VerticalAlignment="Center" />
                                    <CheckBox Grid.Column="1" Content="包含子目录" 
                                              IsChecked="{Binding Config.IncludeSubdirectories}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 卡片 3: 目录名伪装（独立操作） -->
                        <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="目录名伪装" FontWeight="Bold" FontSize="14" Margin="0,0,0,6" />
                                <TextBlock Text="将文件夹内的子目录名添加 _hf_ 前缀，可原样还原。仅降低可读性，不进行加密。"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,12" />
                                <StackPanel Orientation="Horizontal">
                                    <ui:Button Content="伪装目录名" Command="{Binding ObfuscateDirNamesCommand}"
                                               Appearance="Primary" Margin="0,0,8,0" AutomationProperties.AutomationId="DirObfuscate" />
                                    <ui:Button Content="还原目录名" Command="{Binding RestoreDirNamesCommand}"
                                               Appearance="Secondary" AutomationProperties.AutomationId="DirRestore" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 卡片 4: Windows 资源管理器右键菜单 -->
                        <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="资源管理器右键菜单" FontWeight="Bold" FontSize="14" Margin="0,0,0,6" />
                                    <TextBlock Text="在文件、文件夹右键菜单中添加快捷操作。" 
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="当前状态: 已安装" Foreground="#10B981" FontWeight="SemiBold" Margin="0,8,0,0"
                                               Visibility="{Binding IsContextMenuInstalled, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <TextBlock Text="当前状态: 未安装" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,8,0,0"
                                               Visibility="{Binding IsContextMenuInstalled, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}" />
                                </StackPanel>

                                <ui:Button Grid.Column="1" 
                                           Command="{Binding ToggleContextMenuCommand}"
                                           Width="150" Height="36" Margin="16,0,0,0"
                                           VerticalAlignment="Center">
                                    <ui:Button.Style>
                                        <Style TargetType="ui:Button">
                                            <Setter Property="Content" Value="添加右键菜单" />
                                            <Setter Property="Appearance" Value="Primary" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsContextMenuInstalled}" Value="True">
                                                    <Setter Property="Content" Value="移除右键菜单" />
                                                    <Setter Property="Appearance" Value="Danger" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:Button.Style>
                                </ui:Button>
                            </Grid>
                        </Border>

                        <!-- 卡片 5: 格式伪装规则 -->
                        <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel>
                                <TextBlock Text="格式伪装规则" FontWeight="Bold" FontSize="14" Margin="0,0,0,12" />
                                <ItemsControl ItemsSource="{Binding Config.Groups}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="120" />
                                                        <ColumnDefinition Width="140" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding Enabled}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="伪装后缀: " Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                        <TextBox Text="{Binding FakeExtension, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="4,0,0,0" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" 
                                                               Text="{Binding Extensions, Converter={StaticResource ListToStringConverter}}" 
                                                               VerticalAlignment="Center" 
                                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                               Margin="12,0,0,0"
                                                               TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                                    <Button Content="恢复默认" Command="{Binding ResetConfigCommand}" Margin="0,0,8,0" />
                                    <ui:Button Content="保存设置" Command="{Binding SaveConfigCommand}" Appearance="Primary" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 4: 关于 -->
            <TabItem Header="关于">
                <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="24" Margin="0,12,0,0">
                    <StackPanel MaxWidth="640" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Image Source="pack://application:,,,/HideFilesApp;component/Assets/Icon/AppIcon.png" Width="40" Height="40" Margin="0,0,12,0" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="HideFiles v1.0.0" FontSize="18" FontWeight="Bold" />
                                <TextBlock Text="Windows 文件加密工具" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                        <Separator Margin="0,0,0,12" />
                        <TextBlock Text="功能说明：" FontWeight="Bold" Margin="0,0,0,8" />
                        <TextBlock Text="1. 结构加密：原地加密文件头部与关键结构，耗时极短，适合大体积音视频与图片。" TextWrapping="Wrap" Margin="0,0,0,6" />
                        <TextBlock Text="2. 整体加密：使用 AES-256-GCM 加密完整文件，适合任意格式文件。" TextWrapping="Wrap" Margin="0,0,0,6" />
                        <TextBlock Text="3. 密码与恢复码：支持密码保护与紧急恢复码解密，修改密码不影响已加密文件。" TextWrapping="Wrap" Margin="0,0,0,6" />
                        <TextBlock Text="4. 安全机制：失败自动回滚，目标重名自动编号，不覆盖已有文件。" TextWrapping="Wrap" Margin="0,0,0,6" />
                        <Separator Margin="0,8,0,10" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="运行环境: " Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{Binding DeploymentModeDisplay}" FontWeight="SemiBold" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </TabItem>
        </TabControl>

        <!-- 底部状态栏与进度条 -->
        <Border Grid.Row="2" Background="{DynamicResource ControlFillColorSecondaryBrush}" 
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="220" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <ProgressBar Grid.Column="1" Value="{Binding ProgressValue}" Maximum="100" Height="8" 
                             Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVisibilityConverter}}" />
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
