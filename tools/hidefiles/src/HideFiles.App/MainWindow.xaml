<ui:FluentWindow x:Class="HideFiles.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:HideFiles.App.ViewModels"
                 Title="{Binding Title}"
                 Height="700" Width="960"
                 MinHeight="550" MinWidth="750"
                 WindowStartupLocation="CenterScreen"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True">

    <ui:FluentWindow.DataContext>
        <vm:MainViewModel />
    </ui:FluentWindow.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <ui:TitleBar Grid.Row="0" Title="{Binding Title}" />

        <!-- 主内容多标签页 -->
        <TabControl Grid.Row="1" Margin="16,4,16,12">
            <!-- TAB 1: 工作台 -->
            <TabItem Header="文件处理工作台">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 顶部统计与操作卡片 -->
                    <Border Grid.Row="0" Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="当前文件: " Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding TotalCount}" FontWeight="Bold" Margin="0,0,16,0" />

                                <TextBlock Text="待混淆 (普通): " Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding NormalCount}" FontWeight="Bold" Foreground="#10B981" Margin="0,0,16,0" />

                                <TextBlock Text="已混淆保护: " Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding ObfuscatedCount}" FontWeight="Bold" Foreground="#F59E0B" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="选择文件" Command="{Binding SelectFilesCommand}" Margin="0,0,8,0" />
                                <Button Content="选择文件夹" Command="{Binding SelectFolderCommand}" Margin="0,0,8,0" />
                                <Button Content="清空列表" Command="{Binding ClearFilesCommand}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 操作栏 -->
                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="💡 提示：可直接拖拽多个文件或整个文件夹到下方列表中" 
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" 
                                   VerticalAlignment="Center" />

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <ui:Button Content="🛡️ 混淆保护 (Hide)" 
                                       Command="{Binding ObfuscateSelectedCommand}" 
                                       Appearance="Primary" 
                                       Margin="0,0,8,0" />
                            <ui:Button Content="🔓 一键还原 (Unhide)" 
                                       Command="{Binding RestoreSelectedCommand}" 
                                       Appearance="Secondary" />
                        </StackPanel>
                    </Grid>

                    <!-- 文件列表 -->
                    <Border Grid.Row="2" 
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8"
                            AllowDrop="True" Drop="FileList_Drop" DragOver="FileList_DragOver">
                        <DataGrid ItemsSource="{Binding Files}" 
                                  AutoGenerateColumns="False" 
                                  CanUserAddRows="False"
                                  GridLinesVisibility="Horizontal"
                                  HeadersVisibility="Column"
                                  Background="Transparent"
                                  BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="选" Binding="{Binding IsSelected}" Width="40" />
                                <DataGridTemplateColumn Header="状态" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="4" Padding="6,2"
                                                    Background="{Binding Status, Converter={StaticResource StatusToColorConverter}}"
                                                    HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding StatusText}" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="文件名" Binding="{Binding FileName}" Width="220" FontWeight="SemiBold" />
                                <DataGridTextColumn Header="原始文件名 (还原目标)" Binding="{Binding OriginalFileName}" Width="200" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <DataGridTextColumn Header="大小" Binding="{Binding DisplaySize}" Width="90" />
                                <DataGridTextColumn Header="路径" Binding="{Binding FilePath}" Width="*" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 2: 规则与设置 -->
            <TabItem Header="规则与系统设置">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                    <StackPanel>
                        <!-- 右键菜单集成卡片 -->
                        <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="Windows 资源管理器右键级联菜单 (折叠主入口)" FontWeight="Bold" FontSize="14" Margin="0,0,0,6" />
                                    <TextBlock Text="在文件、文件夹或空白处添加 'HideFiles' 折叠菜单，支持一键混淆与还原，无需管理员权限。" 
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="当前状态: 已安装" Foreground="#10B981" FontWeight="SemiBold" Margin="0,8,0,0"
                                               Visibility="{Binding IsContextMenuInstalled, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <TextBlock Text="当前状态: 未安装" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,8,0,0"
                                               Visibility="{Binding IsContextMenuInstalled, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}" />
                                </StackPanel>

                                <ui:Button Grid.Column="1" 
                                           Command="{Binding ToggleContextMenuCommand}"
                                           VerticalAlignment="Center">
                                    <ui:Button.Style>
                                        <Style TargetType="ui:Button">
                                            <Setter Property="Content" Value="安装右键折叠菜单" />
                                            <Setter Property="Appearance" Value="Primary" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsContextMenuInstalled}" Value="True">
                                                    <Setter Property="Content" Value="移除右键菜单" />
                                                    <Setter Property="Appearance" Value="Danger" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:Button.Style>
                                </ui:Button>
                            </Grid>
                        </Border>

                        <!-- 混淆策略设置 -->
                        <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel>
                                <TextBlock Text="混淆强度与性能选项" FontWeight="Bold" FontSize="14" Margin="0,0,0,12" />
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="混淆头部数据量:" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" SelectedValuePath="Tag" SelectedValue="{Binding Config.HeadObfuscateSize}" Width="240" HorizontalAlignment="Left">
                                        <ComboBoxItem Content="4 KB (超极速，微秒级)" Tag="4096" />
                                        <ComboBoxItem Content="64 KB (默认推荐，彻底破坏特征)" Tag="65536" IsSelected="True" />
                                        <ComboBoxItem Content="256 KB (高强度容器破坏)" Tag="262144" />
                                        <ComboBoxItem Content="1 MB (深度特征抹除)" Tag="1048576" />
                                    </ComboBox>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="目录混淆策略:" VerticalAlignment="Center" />
                                    <CheckBox Grid.Column="1" Content="包含子目录递归扫描" IsChecked="{Binding Config.IncludeSubdirectories}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 扩展名映射规则列表 -->
                        <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel>
                                <TextBlock Text="扩展名伪装映射规则 (内置媒体规则)" FontWeight="Bold" FontSize="14" Margin="0,0,0,12" />
                                <ItemsControl ItemsSource="{Binding Config.Groups}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="120" />
                                                        <ColumnDefinition Width="140" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding Enabled}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="伪装后缀: " Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                        <TextBox Text="{Binding FakeExtension, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="4,0,0,0" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" 
                                                               Text="{Binding Extensions, Converter={x:Null}}" 
                                                               VerticalAlignment="Center" 
                                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                                    <Button Content="重置为默认配置" Command="{Binding ResetConfigCommand}" Margin="0,0,8,0" />
                                    <ui:Button Content="保存配置变更" Command="{Binding SaveConfigCommand}" Appearance="Primary" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 3: 关于 -->
            <TabItem Header="关于">
                <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="24" Margin="0,12,0,0">
                    <StackPanel MaxWidth="600" HorizontalAlignment="Left">
                        <TextBlock Text="HideFiles v1.0.0" FontSize="18" FontWeight="Bold" Margin="0,0,0,6" />
                        <TextBlock Text="极速自包含文件特征混淆与还原小工具 (Windows .NET 8)" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,12" />
                        <Separator Margin="0,0,0,12" />
                        <TextBlock Text="核心技术原理：" FontWeight="Bold" Margin="0,0,0,8" />
                        <TextBlock Text="1. 自包含元数据 (In-File Stash)：原始头部特征、原始文件名与扩展名加密追加至文件尾部，单文件独立便携，移动或改名皆可无损还原。" TextWrapping="Wrap" Margin="0,0,0,6" />
                        <TextBlock Text="2. 极速就地掩码 (In-Place Obfuscation)：仅针对前 64KB 头部进行特征覆盖，单文件处理耗时低于 2ms，支持上万文件秒级批处理。" TextWrapping="Wrap" Margin="0,0,0,6" />
                        <TextBlock Text="3. 防二次混淆与防呆设计：尾部专属魔数识别，杜绝重复混淆损坏真实数据。" TextWrapping="Wrap" Margin="0,0,0,6" />
                        <TextBlock Text="4. 级联折叠右键菜单：原生注册表集成，保持桌面与资源管理器整洁。" TextWrapping="Wrap" Margin="0,0,0,6" />
                    </StackPanel>
                </Border>
            </TabItem>
        </TabControl>

        <!-- 底部状态栏与进度条 -->
        <Border Grid.Row="2" Background="{DynamicResource ControlFillColorSecondaryBrush}" 
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="220" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <ProgressBar Grid.Column="1" Value="{Binding ProgressValue}" Maximum="100" Height="8" 
                             Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVisibilityConverter}}" />
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
