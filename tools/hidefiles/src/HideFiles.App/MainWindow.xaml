<ui:FluentWindow x:Class="HideFiles.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:HideFiles.App.ViewModels"
                 Title="{Binding Title}"
                 Height="740" Width="1140"
                 MinHeight="620" MinWidth="900"
                 WindowStartupLocation="CenterScreen"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True"
                 Icon="pack://application:,,,/CarroCasket;component/Assets/Icon/AppIcon.png">

    <ui:FluentWindow.DataContext>
        <vm:MainViewModel />
    </ui:FluentWindow.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题栏：带图标与标题 -->
        <ui:TitleBar Grid.Row="0" Title="{Binding Title}">
            <ui:TitleBar.Icon>
                <ui:ImageIcon>
                    <ui:ImageIcon.Source>
                        <BitmapImage UriSource="pack://application:,,,/CarroCasket;component/Assets/Icon/AppIcon.png" />
                    </ui:ImageIcon.Source>
                </ui:ImageIcon>
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- 主内容多标签页 -->
        <TabControl x:Name="RootTabControl" Grid.Row="1" Margin="24"
                    SelectedIndex="{Binding SelectedTabIndex}"
                    ItemContainerStyle="{StaticResource MainTabItemStyle}"
                    Background="Transparent" BorderThickness="0">
            <!-- TAB 1: 混淆（结构模式，只处理媒体格式） -->
            <TabItem Header="混淆">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="当前文件: " Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding TotalCount}" FontWeight="Bold" Margin="0,0,16,0" />
                                <TextBlock Text="可混淆: " Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding NormalCount}" FontWeight="Bold" Foreground="#10B981" Margin="0,0,16,0" />
                                <TextBlock Text="已混淆: " Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding ObfuscatedCount}" FontWeight="Bold" Foreground="#F59E0B" Margin="0,0,16,0" />
                                <TextBlock Text="不支持: " Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Visibility="{Binding HasUnsupported, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <TextBlock Text="{Binding UnsupportedCount}" FontWeight="Bold" Foreground="#9CA3AF"
                                           Visibility="{Binding HasUnsupported, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="选择文件" Command="{Binding SelectFilesCommand}" CommandParameter="struct" Margin="0,0,8,0" AutomationProperties.AutomationId="StructSelectFiles" />
                                <Button Content="选择文件夹" Command="{Binding SelectFolderCommand}" CommandParameter="struct" Margin="0,0,8,0" />
                                <Button Content="导出失败清单" Command="{Binding ExportFailureReportCommand}" Margin="0,0,8,0"
                                        Visibility="{Binding HasFailureReport, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <Button Content="清空列表" Command="{Binding ClearFilesCommand}" CommandParameter="struct" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="原地混淆文件头部与关键结构，支持大文件快速处理"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <ui:Button Content="混淆" Command="{Binding ObfuscateSelectedCommand}"
                                       Appearance="Primary" Margin="0,0,8,0" AutomationProperties.AutomationId="StructObfuscate" />
                            <ui:Button Content="还原" Command="{Binding RestoreSelectedCommand}"
                                       Appearance="Secondary" AutomationProperties.AutomationId="StructRestore" />
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="2" Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8"
                            AllowDrop="True" Drop="FileList_Drop" DragOver="FileList_DragOver">
                        <Grid>
                            <!-- 空状态引导占位 -->
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                        Visibility="{Binding HasFiles, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}">
                                <TextBlock Text="📂" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,10" />
                                <TextBlock Text="拖拽文件或文件夹到此处" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                <TextBlock Text="支持 MP4 / MKV / JPG / PNG 等媒体格式（其它格式请用“加密”）" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,14" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <ui:Button Content="选择文件" Command="{Binding SelectFilesCommand}" CommandParameter="struct" Margin="0,0,8,0" />
                                    <ui:Button Content="选择文件夹" Command="{Binding SelectFolderCommand}" CommandParameter="struct" />
                                </StackPanel>
                            </StackPanel>

                            <!-- 文件列表 -->
                            <DataGrid x:Name="StructFileGrid" ItemsSource="{Binding Files}" AutoGenerateColumns="False" CanUserAddRows="False"
                                      GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                                      Background="Transparent" BorderThickness="0"
                                      Visibility="{Binding HasFiles, Converter={StaticResource BoolToVisibilityConverter}}">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Width="50">
                                        <DataGridTemplateColumn.Header>
                                            <CheckBox Command="{Binding DataContext.ToggleSelectAllCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                      CommandParameter="struct" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0" Padding="0" />
                                        </DataGridTemplateColumn.Header>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" 
                                                          HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0" Padding="0" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="状态" Width="130">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="4" Padding="6,2"
                                                        HorizontalAlignment="Center"
                                                        ToolTip="{Binding ErrorMessage}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background"
                                                                    Value="{Binding Status, Converter={StaticResource StatusToColorConverter}}" />
                                                            <Style.Triggers>
                                                                <!-- 处理失败的项用红色标出；"不支持"不是失败，保持 Status 决定的灰色 -->
                                                                <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                                                    <Setter Property="Background" Value="#EF4444" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding StatusText}" Foreground="White" FontSize="11" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" MaxWidth="112" />
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="文件名" Binding="{Binding FileName}" Width="180" FontWeight="SemiBold" />
                                    <DataGridTextColumn Header="原始文件名" Binding="{Binding OriginalFileName}" Width="160" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <DataGridTextColumn Header="大小" Binding="{Binding DisplaySize}" Width="80" />
                                    <DataGridTextColumn Header="完整路径" Binding="{Binding FilePath}" MinWidth="300" Width="*" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    <DataGridTemplateColumn Header="操作" Width="50">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="✕" ToolTip="移出列表" Padding="0" Width="22" Height="22"
                                                        Command="{Binding DataContext.RemoveFileCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        Background="Transparent" BorderThickness="0"
                                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 2: 加密（整体模式，任意格式） -->
            <TabItem Header="加密">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="当前文件: " Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding SecureTotalCount}" FontWeight="Bold" Margin="0,0,16,0" />
                                <TextBlock Text="未加密: " Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding SecureNormalCount}" FontWeight="Bold" Foreground="#10B981" Margin="0,0,16,0" />
                                <TextBlock Text="已加密: " Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding SecureObfuscatedCount}" FontWeight="Bold" Foreground="#F59E0B" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="选择文件" Command="{Binding SelectFilesCommand}" CommandParameter="secure" Margin="0,0,8,0" AutomationProperties.AutomationId="SecureSelectFiles" />
                                <Button Content="选择文件夹" Command="{Binding SelectFolderCommand}" CommandParameter="secure" Margin="0,0,8,0" />
                                <Button Content="导出失败清单" Command="{Binding ExportFailureReportCommand}" Margin="0,0,8,0"
                                        Visibility="{Binding HasFailureReport, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <Button Content="清空列表" Command="{Binding ClearFilesCommand}" CommandParameter="secure" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="分块加密全文件（AES-256-GCM），支持任意格式"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <ui:Button Content="加密" Command="{Binding EncryptSelectedCommand}"
                                       Appearance="Primary" Margin="0,0,8,0" AutomationProperties.AutomationId="SecureEncrypt" />
                            <ui:Button Content="解密" Command="{Binding DecryptSelectedCommand}"
                                       Appearance="Secondary" AutomationProperties.AutomationId="SecureDecrypt" />
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="2" Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8"
                            AllowDrop="True" Drop="FileList_Drop" DragOver="FileList_DragOver">
                        <Grid>
                            <!-- 空状态引导占位 -->
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                        Visibility="{Binding HasSecureFiles, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}">
                                <TextBlock Text="📂" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,10" />
                                <TextBlock Text="拖拽文件或文件夹到此处" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                <TextBlock Text="支持任意格式音视频、图片及文档" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,14" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <ui:Button Content="选择文件" Command="{Binding SelectFilesCommand}" CommandParameter="secure" Margin="0,0,8,0" />
                                    <ui:Button Content="选择文件夹" Command="{Binding SelectFolderCommand}" CommandParameter="secure" />
                                </StackPanel>
                            </StackPanel>

                            <!-- 文件列表 -->
                            <DataGrid x:Name="SecureFileGrid" ItemsSource="{Binding SecureFiles}" AutoGenerateColumns="False" CanUserAddRows="False"
                                      GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                                      Background="Transparent" BorderThickness="0"
                                      Visibility="{Binding HasSecureFiles, Converter={StaticResource BoolToVisibilityConverter}}">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Width="50">
                                        <DataGridTemplateColumn.Header>
                                            <CheckBox Command="{Binding DataContext.ToggleSelectAllCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                      CommandParameter="secure" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0" Padding="0" />
                                        </DataGridTemplateColumn.Header>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" 
                                                          HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0" Padding="0" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="状态" Width="130">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="4" Padding="6,2"
                                                        HorizontalAlignment="Center"
                                                        ToolTip="{Binding ErrorMessage}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background"
                                                                    Value="{Binding Status, Converter={StaticResource StatusToColorConverter}}" />
                                                            <Style.Triggers>
                                                                <!-- 处理失败的项用红色标出；"不支持"不是失败，保持 Status 决定的灰色 -->
                                                                <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                                                    <Setter Property="Background" Value="#EF4444" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding StatusText}" Foreground="White" FontSize="11" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" MaxWidth="112" />
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="文件名" Binding="{Binding FileName}" Width="180" FontWeight="SemiBold" />
                                    <DataGridTextColumn Header="原始文件名" Binding="{Binding OriginalFileName}" Width="160" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <DataGridTextColumn Header="大小" Binding="{Binding DisplaySize}" Width="80" />
                                    <DataGridTextColumn Header="完整路径" Binding="{Binding FilePath}" MinWidth="300" Width="*" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    <DataGridTemplateColumn Header="操作" Width="50">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="✕" ToolTip="移出列表" Padding="0" Width="22" Height="22"
                                                        Command="{Binding DataContext.RemoveFileCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        Background="Transparent" BorderThickness="0"
                                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 3: 设置 -->
            <TabItem Header="设置">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                    <StackPanel>
                        <!-- 卡片 1: 密码与恢复码（1 行） -->
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="密码设置" Style="{StaticResource SettingsCardTitleStyle}" />
                                <Border Grid.Column="1" Background="#1A10B981" CornerRadius="4" Padding="7,2" Margin="10,0,0,0"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding HasPinConfigured, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="已设置" Foreground="#10B981" FontSize="11" FontWeight="SemiBold" />
                                </Border>
                                <Border Grid.Column="1" Background="#1A6B7280" CornerRadius="4" Padding="7,2" Margin="10,0,0,0"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding HasPinConfigured, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}">
                                    <TextBlock Text="未设置" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                </Border>

                                <!-- 中间弹性区：平时放说明；刚设完密码时整行换成恢复码 -->
                                <TextBlock Grid.Column="2" Margin="16,0,16,0"
                                           Text="忘记密码时可用恢复码解密；修改密码不影响已加密文件"
                                           Style="{StaticResource SettingsHintStyle}"
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding HasRecoveryCode, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}" />

                                <Grid Grid.Column="2" Margin="16,0,16,0"
                                      Visibility="{Binding HasRecoveryCode, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding RecoveryCodeGroupedDisplay, Mode=OneWay}" IsReadOnly="True"
                                             FontFamily="Consolas" FontSize="12" Height="28" Padding="6,2"
                                             VerticalContentAlignment="Center" Background="#2ABA7517"
                                             Foreground="#8A4B08"
                                             ToolTip="恢复码仅显示一次，请立即妥善保存"
                                             AutomationProperties.AutomationId="RecoveryCodeBox" />
                                    <ui:Button Grid.Column="1" Content="复制" Command="{Binding CopyRecoveryCodeCommand}"
                                               Height="28" Padding="10,2" FontSize="12" Margin="8,0,0,0" />
                                </Grid>

                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:Button Content="设置密码" Command="{Binding PromptSetPinCommand}" Appearance="Primary" Height="30" Padding="10,3" FontSize="12.5" Margin="0,0,8,0"
                                               Visibility="{Binding HasPinConfigured, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}" />
                                    <ui:Button Content="修改密码" Command="{Binding PromptChangePinCommand}" Appearance="Secondary" Height="30" Padding="10,3" FontSize="12.5" Margin="0,0,8,0"
                                               Visibility="{Binding HasPinConfigured, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <ui:Button Content="清除密码" Command="{Binding PromptClearPinCommand}" Appearance="Danger" Height="30" Padding="10,3" FontSize="12.5"
                                               Visibility="{Binding HasPinConfigured, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 卡片 2: 数据存储（1 行） -->
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="数据存储" Style="{StaticResource SettingsCardTitleStyle}" />
                                <Border Grid.Column="1" Background="#1A3B82F6" CornerRadius="4" Padding="7,2" Margin="10,0,0,0"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding IsPortableMode, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="便携模式" Foreground="#3B82F6" FontSize="11" FontWeight="SemiBold" />
                                </Border>
                                <Border Grid.Column="1" Background="#1A10B981" CornerRadius="4" Padding="7,2" Margin="10,0,0,0"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding IsPortableMode, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}">
                                    <TextBlock Text="标准模式" Foreground="#10B981" FontSize="11" FontWeight="SemiBold" />
                                </Border>

                                <!-- 中间：目录路径（可选中复制）；完整路径见 ToolTip，便携说明压到按钮左侧 -->
                                <Grid Grid.Column="2" Margin="16,0,16,0" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="目录" Style="{StaticResource SettingsFieldLabelStyle}" />
                                    <TextBox Grid.Column="1" Text="{Binding DataDirectoryDisplay, Mode=OneWay}" IsReadOnly="True"
                                             FontSize="12" Height="28" Padding="6,2" VerticalContentAlignment="Center"
                                             Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                             AutomationProperties.AutomationId="DataDirectoryBox"
                                             ToolTip="{Binding DataDirectoryDisplay}" />
                                    <TextBlock Grid.Column="2" Text="放 portable.ini 可切换" Margin="10,0,0,0"
                                               Style="{StaticResource SettingsHintStyle}"
                                               Visibility="{Binding IsPortableMode, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}" />
                                    <TextBlock Grid.Column="2" Text="可随程序拷贝" Margin="10,0,0,0"
                                               Style="{StaticResource SettingsHintStyle}"
                                               Visibility="{Binding IsPortableMode, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </Grid>

                                <ui:Button Grid.Column="3" Content="打开目录" Command="{Binding OpenDataDirectoryCommand}"
                                           Appearance="Secondary" Height="30" Padding="10,3" FontSize="12.5"
                                           VerticalAlignment="Center" HorizontalAlignment="Right"
                                           AutomationProperties.AutomationId="OpenDataDir" />
                            </Grid>
                        </Border>

                        <!-- 卡片 3: 混淆文件名（1 行） -->
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="混淆文件名" Style="{StaticResource SettingsCardTitleStyle}" />

                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="头部加密长度" Style="{StaticResource SettingsFieldLabelStyle}" />
                                    <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding Config.HeadObfuscateSize}"
                                              Width="150" FontSize="12.5" VerticalContentAlignment="Center"
                                              AutomationProperties.AutomationId="HeadSizeCombo">
                                        <ComboBoxItem Content="4 KB" Tag="4096" />
                                        <ComboBoxItem Content="64 KB（默认）" Tag="65536" IsSelected="True" />
                                        <ComboBoxItem Content="256 KB" Tag="262144" />
                                        <ComboBoxItem Content="1 MB" Tag="1048576" />
                                    </ComboBox>
                                    <CheckBox Content="文件名加 hf_ 前缀" Margin="24,0,0,0"
                                              VerticalAlignment="Center" IsChecked="{Binding Config.ObfuscateFileName}"
                                              AutomationProperties.AutomationId="ObfuscateFileNameCheck" />
                                    <CheckBox Content="扫描含子目录" Margin="24,0,0,0"
                                              VerticalAlignment="Center" IsChecked="{Binding Config.IncludeSubdirectories}"
                                              AutomationProperties.AutomationId="IncludeSubdirsCheck" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 卡片 4: 目录名伪装（1 行） -->
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="目录名伪装" Style="{StaticResource SettingsCardTitleStyle}" />
                                <TextBlock Grid.Column="1" Text="子目录名加 _hf_ 前缀，可原样还原；仅降低可读性"
                                           Margin="12,0,12,0" Style="{StaticResource SettingsHintStyle}" TextTrimming="CharacterEllipsis" />

                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <ui:Button Content="伪装" Command="{Binding ObfuscateDirNamesCommand}"
                                               Appearance="Primary" Height="30" Padding="12,3" FontSize="12.5" Margin="0,0,8,0"
                                               AutomationProperties.AutomationId="DirObfuscate" />
                                    <ui:Button Content="还原" Command="{Binding RestoreDirNamesCommand}"
                                               Appearance="Secondary" Height="30" Padding="12,3" FontSize="12.5"
                                               AutomationProperties.AutomationId="DirRestore" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 卡片 5: Windows 资源管理器右键菜单（1 行） -->
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="右键菜单" Style="{StaticResource SettingsCardTitleStyle}" />
                                <Border Grid.Column="1" Background="#1A10B981" CornerRadius="4" Padding="7,2" Margin="10,0,0,0"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding IsContextMenuInstalled, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="已安装" Foreground="#10B981" FontSize="11" FontWeight="SemiBold" />
                                </Border>
                                <Border Grid.Column="1" Background="#1A6B7280" CornerRadius="4" Padding="7,2" Margin="10,0,0,0"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding IsContextMenuInstalled, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}">
                                    <TextBlock Text="未安装" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                </Border>

                                <TextBlock Grid.Column="2" Margin="16,0,16,0"
                                           Text="含 混淆/还原、加密/解密、打开工作台，自动判断当前状态"
                                           Style="{StaticResource SettingsHintStyle}"
                                           TextTrimming="CharacterEllipsis" />

                                <ui:Button Grid.Column="3"
                                           Command="{Binding ToggleContextMenuCommand}"
                                           Height="30" Padding="12,3" FontSize="12.5"
                                           VerticalAlignment="Center" HorizontalAlignment="Right"
                                           AutomationProperties.AutomationId="ToggleContextMenu">
                                    <ui:Button.Style>
                                        <Style TargetType="ui:Button">
                                            <Setter Property="Content" Value="添加" />
                                            <Setter Property="Appearance" Value="Primary" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsContextMenuInstalled}" Value="True">
                                                    <Setter Property="Content" Value="移除" />
                                                    <Setter Property="Appearance" Value="Danger" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:Button.Style>
                                </ui:Button>
                            </Grid>
                        </Border>

                        <!-- 卡片 6: 格式规则（紧凑两列表格） -->
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="格式规则" Style="{StaticResource SettingsCardTitleStyle}" />
                                    <TextBlock Grid.Column="1" Text="勾选启用分组；方框为伪装后缀"
                                               Margin="12,0,12,0" HorizontalAlignment="Left"
                                               Style="{StaticResource SettingsHintStyle}" TextTrimming="CharacterEllipsis" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <Button Content="恢复默认" Command="{Binding ResetConfigCommand}" Height="26" Padding="10,2" FontSize="12" Margin="0,0,6,0" />
                                        <ui:Button Content="保存设置" Command="{Binding SaveConfigCommand}" Appearance="Primary"
                                                   Height="26" Padding="12,2" FontSize="12" AutomationProperties.AutomationId="SaveConfig" />
                                    </StackPanel>
                                </Grid>

                                <ItemsControl ItemsSource="{Binding Config.Groups}" AutomationProperties.AutomationId="FormatRuleList">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="2" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                    BorderThickness="0,1,0,0" Padding="0,7" Margin="0,0,12,0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding Enabled}"
                                                              FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                                                              MinHeight="0" Padding="0" />
                                                    <TextBox Grid.Column="1" Text="{Binding FakeExtension, UpdateSourceTrigger=PropertyChanged}"
                                                             Width="60" Height="24" MinHeight="0" FontSize="11.5" Padding="6,0" Margin="8,0,0,0"
                                                             VerticalContentAlignment="Center"
                                                             AutomationProperties.AutomationId="FakeExtBox"
                                                             ToolTip="伪装后缀，如 .dat" />
                                                    <TextBlock Grid.Column="2" Margin="8,0,0,0"
                                                               Text="{Binding Extensions, Converter={StaticResource ListToStringConverter}}"
                                                               FontSize="11" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding Extensions, Converter={StaticResource ListToStringConverter}}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 4: 关于 -->
            <TabItem Header="关于">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="32,24" Margin="32,24"
                            MaxWidth="600" HorizontalAlignment="Center">
                        <StackPanel HorizontalAlignment="Center">
                            <!-- 图标与主标题居中 -->
                            <StackPanel HorizontalAlignment="Center" Margin="0,0,0,16">
                                <Image Source="pack://application:,,,/CarroCasket;component/Assets/Icon/AppIcon.png" Width="48" Height="48" HorizontalAlignment="Center" Margin="0,0,0,8" />
                                <TextBlock Text="{Binding AppVersionDisplay}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center" />
                                <TextBlock Text="Windows 文件混淆与加密工具" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,4,0,0" />
                            </StackPanel>
                            <Separator Margin="0,0,0,16" />
                            <TextBlock Text="功能说明" FontWeight="Bold" Margin="0,0,0,8" HorizontalAlignment="Center" />
                            <TextBlock Text="1. 混淆：原地混淆文件头部与关键结构，耗时极短，适合大体积音视频与图片。" TextWrapping="Wrap" Margin="0,0,0,6" TextAlignment="Center" />
                            <TextBlock Text="2. 加密：全文件 AES-256-GCM 加密，适合任意格式文件，提供密码学级保护。" TextWrapping="Wrap" Margin="0,0,0,6" TextAlignment="Center" />
                            <TextBlock Text="3. 密码与恢复码：支持密码保护与紧急恢复码解密，修改密码不影响已加密文件。" TextWrapping="Wrap" Margin="0,0,0,6" TextAlignment="Center" />
                            <TextBlock Text="4. 安全机制：失败自动回滚，目标重名自动编号，不覆盖已有文件。" TextWrapping="Wrap" Margin="0,0,0,6" TextAlignment="Center" />
                            <Separator Margin="0,12,0,14" />
                            <Grid HorizontalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="运行环境: " Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,12,6" TextAlignment="Right" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DeploymentModeDisplay}" FontWeight="SemiBold" Margin="0,0,0,6" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="提交版本: " Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,12,6" TextAlignment="Right" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding GitHashDisplay}" FontFamily="Consolas, Cascadia Code, monospace" FontWeight="SemiBold" Margin="0,0,0,6" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="构建时间: " Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,12,6" TextAlignment="Right" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding BuildTimeDisplay}" Margin="0,0,0,6" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- 底部状态栏与进度条 -->
        <Border Grid.Row="2" Background="{DynamicResource ControlFillColorSecondaryBrush}" 
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                            Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ProgressBar Value="{Binding ProgressValue}" Maximum="100" Width="160" Height="8" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <ui:Button Content="取消" Appearance="Secondary" Padding="10,2" Height="26"
                               Command="{Binding CancelProcessingCommand}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
