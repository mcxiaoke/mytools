<ui:FluentWindow x:Class="HideFiles.App.Views.PasswordDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="密码设置"
                 Height="380" Width="420"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="NoResize"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True"
                 Icon="pack://application:,,,/CarroCasket;component/Assets/Icon/AppIcon.png">
    <Grid Margin="24,12,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <ui:TitleBar x:Name="TitleBarControl" Grid.Row="0" Title="密码设置" ShowMaximize="False" ShowMinimize="False" />

        <StackPanel Grid.Row="1" Margin="0,8,0,10">
            <TextBlock x:Name="HintText" Text="提示信息"
                       FontWeight="SemiBold" FontSize="13" Margin="0,0,0,12" TextWrapping="Wrap" />

            <!-- 当前密码（仅 Change 模式显示） -->
            <StackPanel x:Name="CurrentPasswordPanel" Visibility="Collapsed" Margin="0,0,0,10">
                <TextBlock Text="当前密码：" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,0,0,4" />
                <PasswordBox x:Name="CurrentPasswordBox" Height="34" FontSize="14" VerticalContentAlignment="Center" KeyDown="Input_KeyDown" />
            </StackPanel>

            <!-- 密码输入 / 新密码 -->
            <StackPanel x:Name="PasswordPanel" Margin="0,0,0,10">
                <TextBlock x:Name="PasswordLabel" Text="新密码：" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,0,0,4" />
                <PasswordBox x:Name="PasswordBoxControl" Height="34" FontSize="14" VerticalContentAlignment="Center" KeyDown="Input_KeyDown" />
            </StackPanel>

            <!-- 确认新密码（仅 Set 与 Change 模式显示） -->
            <StackPanel x:Name="ConfirmPasswordPanel" Visibility="Collapsed" Margin="0,0,0,10">
                <TextBlock Text="确认新密码：" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,0,0,4" />
                <PasswordBox x:Name="ConfirmPasswordBox" Height="34" FontSize="14" VerticalContentAlignment="Center" KeyDown="Input_KeyDown" />
            </StackPanel>

            <!-- 恢复码模式输入框（仅 Verify 模式勾选恢复码时显示） -->
            <StackPanel x:Name="RecoveryPanel" Visibility="Collapsed" Margin="0,0,0,10">
                <TextBlock Text="恢复码：" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,0,0,4" />
                <ui:TextBox x:Name="RecoveryBox" Height="34" FontSize="13" PlaceholderText="输入 52 位恢复码"
                            VerticalContentAlignment="Center" KeyDown="Input_KeyDown" />
            </StackPanel>

            <!-- 切换恢复码复选框（仅 Verify 模式显示） -->
            <CheckBox x:Name="RecoveryModeCheck" Content="使用恢复码" Visibility="Collapsed"
                      Margin="0,0,0,8" Checked="RecoveryMode_Changed" Unchecked="RecoveryMode_Changed" />

            <!-- 错误提示 -->
            <TextBlock x:Name="ErrorText" Text="" Foreground="#EF4444" FontSize="12" Margin="0,2,0,0"
                       Visibility="Collapsed" TextWrapping="Wrap" />
        </StackPanel>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <Button Content="取消" Click="Cancel_Click" Margin="0,0,8,0" Width="80" />
            <ui:Button x:Name="ConfirmButton" Content="确定" Appearance="Primary" Click="Confirm_Click" Width="80" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
