<ui:FluentWindow x:Class="HideFiles.App.Views.ScanProgressDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="扫描文件"
                 Height="230" Width="480"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="NoResize"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True"
                 Icon="pack://application:,,,/CarroCasket;component/Assets/Icon/AppIcon.png">
    <Grid Margin="24,12,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <ui:TitleBar x:Name="TitleBarControl" Grid.Row="0" Title="扫描与分析文件" ShowMaximize="False" ShowMinimize="False" />

        <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,6,0,8">
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="正在搜索文件..." FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="CountText" Grid.Column="1" Text="" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </Grid>

            <ProgressBar x:Name="ProgressBarControl" IsIndeterminate="True" Height="6" Margin="0,0,0,10" />

            <TextBlock x:Name="CurrentPathText" Text="" FontSize="11.5"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       TextTrimming="CharacterEllipsis" MaxWidth="430" HorizontalAlignment="Left" />
        </StackPanel>

        <!-- 底部取消按钮 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <ui:Button x:Name="CancelButton" Content="取消" Appearance="Secondary" Click="Cancel_Click" Width="80" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
