<ui:FluentWindow x:Class="HideFiles.App.Views.OperationProgressDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="正在处理文件"
                 Height="230" Width="480"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="NoResize"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True"
                 Icon="pack://application:,,,/CarroCasket;component/Assets/Icon/AppIcon.png">
    <Grid Margin="24,12,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <ui:TitleBar x:Name="TitleBarControl" Grid.Row="0" Title="正在处理文件" ShowMaximize="False" ShowMinimize="False" />

        <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,6,0,8">
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ActionText" Text="正在处理..." FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="PercentText" Grid.Column="1" Text="0%" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </Grid>

            <ProgressBar x:Name="ProgressBarControl" Maximum="100" Value="0" Height="6" Margin="0,0,0,10" />

            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="CurrentFileText" Text="" FontSize="11.5"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           TextTrimming="CharacterEllipsis" MaxWidth="320" HorizontalAlignment="Left" />
                <TextBlock x:Name="StatsText" Grid.Column="1" Text="完成: 0 / 0" FontSize="11.5"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </Grid>
        </StackPanel>

        <!-- 底部取消按钮 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <ui:Button x:Name="CancelButton" Content="取消" Appearance="Secondary" Click="Cancel_Click" Width="80" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
