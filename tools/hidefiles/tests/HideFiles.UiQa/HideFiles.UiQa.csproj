<Project Sdk="Microsoft.NET.Sdk">

  <!--
    界面验收程序（非 xunit）：WPF 的界面行为（绑定、状态徽章、命令路由）
    必须在真实渲染管线里验证，单元测试覆盖不到。

    运行：dotnet run -c Release -p tests/HideFiles.UiQa
    退出码：0 = 全部通过，1 = 有断言失败，3 = 超时（多半是弹出了模态框）

    设计要点（踩过的坑，勿改）：
    1. 在创建 App/Window 之前设置 HideFilesConfig.DataDirOverride ——
       MainViewModel 构造时就加载配置，晚设会读到用户真实配置并触发密码框。
    2. 用 vm.TryUnlockSession(pin) 预置会话 —— 不弹密码输入框。
    3. 必须安装 DispatcherSynchronizationContext 并只靠 PushFrame 推进 ——
       否则 await 续体落到线程池，跨线程访问 UI 会抛 InvalidOperationException。
    4. 绝不用 GetAwaiter().GetResult() 阻塞 UI 线程（会死锁）；
       用轮询 task.IsCompleted + Pump 的方式等待。
    5. 看门狗线程兜底强退，避免任何 ShowDialog 把自动化挂死。
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>HideFiles.UiQa</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Qa.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\HideFiles.App\HideFiles.App.csproj" />
  </ItemGroup>

</Project>
