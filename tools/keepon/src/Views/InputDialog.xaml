<Window x:Class="KeepOn.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KeepOn" SizeToContent="Height" Width="380"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#FFF6F7F9" ShowInTaskbar="False"
        FontFamily="Segoe UI, Microsoft YaHei UI">
    <Grid Margin="18,16,18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="PromptText" Grid.Row="0" Text="请输入：" FontSize="12.5"
                   Foreground="#FF334155" TextWrapping="Wrap" Margin="0,0,0,8"/>

        <TextBox x:Name="InputBox" Grid.Row="1" Height="28" VerticalContentAlignment="Center"
                 KeyDown="OnInputKeyDown"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="确定" Style="{StaticResource PrimaryButtonStyle}"
                    IsDefault="True" Click="OnOkClick" Margin="0,0,8,0"/>
            <Button Content="取消" Style="{StaticResource SecondaryButtonStyle}"
                    IsCancel="True" Click="OnCancelClick"/>
        </StackPanel>
    </Grid>
</Window>
